{
  "name": "05_listed_only_on_cmdline",
  "description": "Listed only via -c safe.directory; command-line scope is ignored.",
  "fs": [
    {
      "path": "/home/alice",
      "owner": 1000
    },
    {
      "path": "/tmp",
      "owner": 0
    },
    {
      "path": "/srv/shared",
      "owner": 1001
    },
    {
      "path": "/srv/shared/.git",
      "owner": 1001
    },
    {
      "path": "/srv/shared/.git/HEAD",
      "kind": "file",
      "owner": 1001,
      "content": "ref: refs/heads/main"
    },
    {
      "path": "/srv/shared/.git/objects",
      "owner": 1001
    },
    {
      "path": "/srv/shared/.git/refs",
      "owner": 1001
    }
  ],
  "cwd": "/srv/shared",
  "env": {
    "uid": 1000,
    "home": "/home/alice",
    "cmdline": [
      "/srv/shared"
    ]
  }
}