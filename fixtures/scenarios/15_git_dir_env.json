{
  "name": "15_git_dir_env",
  "description": "GIT_DIR set explicitly: GIT_DIR_EXPLICIT, no ownership check in this code path.",
  "fs": [
    {
      "path": "/home/alice",
      "owner": 1000
    },
    {
      "path": "/tmp",
      "owner": 0
    },
    {
      "path": "/srv/shared",
      "owner": 1001
    },
    {
      "path": "/srv/shared/.git",
      "owner": 1001
    },
    {
      "path": "/srv/shared/.git/HEAD",
      "kind": "file",
      "owner": 1001,
      "content": "ref: refs/heads/main"
    },
    {
      "path": "/srv/shared/.git/objects",
      "owner": 1001
    },
    {
      "path": "/srv/shared/.git/refs",
      "owner": 1001
    }
  ],
  "cwd": "/home/alice",
  "env": {
    "uid": 1000,
    "home": "/home/alice",
    "git_dir": "/srv/shared/.git"
  }
}